# Optional environment variables for Research Paper Assistant
# Copy or export as needed; none of these contain secrets.

# Ollama server endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional local Hugging Face cache / offline mode
# HF_HOME=./.hf-cache
# HF_HUB_OFFLINE=1

# Optional local Ollama model directory / offline flag
# OLLAMA_MODELS=./models
# OLLAMA_NO_CLOUD=1
